{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "sourceMap": false,
    "declaration": false,
    "skipLibCheck": true,
    "lib": ["es2022", "dom"]
  },
  "include": ["src/**/*.ts"]
}
