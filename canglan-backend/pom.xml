<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.canglan</groupId>
  <artifactId>canglan-backend</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>canglan-backend</name>
  <description>苍岚大陆 TRPG — Java 后端（标签驱动核心）</description>

  <modules>
    <module>canglan-core</module>
    <module>canglan-data</module>
    <module>canglan-world</module>
    <module>canglan-save</module>
    <module>canglan-ai-client</module>
    <module>canglan-api</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.canglan</groupId>
        <artifactId>canglan-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.canglan</groupId>
        <artifactId>canglan-data</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.canglan</groupId>
        <artifactId>canglan-world</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.canglan</groupId>
        <artifactId>canglan-save</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.canglan</groupId>
        <artifactId>canglan-ai-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
