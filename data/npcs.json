          {
            "condition": "HasTag(暗影行者)",
            "text": "契约在身，你就是我们的人了。这单大买卖，分你一份。",
            "next": "contract",
            "actions": [ { "type": "affinity", "amount": 15 } ]
          },
          { "text": "你偷富济贫，是真是假？", "next": "creed" },
          { "text": "告辞。", "next": "end" }
        ]
      },
      "learn_stealth": { "text": "记住：影子是朋友，灯光是敌人。", "isExit": true },
      "contract": {
        "text": "商队里有赃官的私货，今晚动手。完事后钟楼集合。",
