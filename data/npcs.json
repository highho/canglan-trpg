      "end": { "text": "（咪咪哼着歌回到灶台前）", "isExit": true }
    }
  },
  "scholar_finn": {
    "name": "学者芬恩",
    "identityTags": ["学者"],
    "personalityTags": ["多疑", "乐观"],
    "groups": ["village", "academy"],
    "baseStats": { "HP": 50, "ATK": 4, "DEF": 4, "SPD": 6, "MATK": 14 },
    "relation": "NEUTRAL",
    "dialogueTree": {
      "start": {
        "root": true,
        "text": "（堆满卷轴的书桌后，学者抬起头）嗯？访客。希望你不像上次那个一样，把我的残片当柴烧。",
        "branches": [
          {
            "condition": "NOT HasTag(考古)",
            "text": "对古物有兴趣？好吧，我先教你辨认遗迹文字的基础。",
            "next": "learn_arch",
            "actions": [ { "type": "addTag", "tag": "考古" }, { "type": "affinity", "amount": 5 } ]
          },
          {
            "condition": "HasTag(古城探索者)",
            "text": "你进过古城深处？！快说说，祭坛上的铭文写了什么？",
            "next": "ruin_talk",
            "actions": [ { "type": "affinity", "amount": 15 } ]
          },
          { "text": "古城是什么地方？", "next": "ruin_lore" },
          { "text": "不打扰了。", "next": "end" }
        ]
      },
      "learn_arch": { "text": "遗迹里的东西，先记录，再触碰。顺序错了，命就没了。", "isExit": true },
      "ruin_talk": {
        "text": "果然如此……古王国是被魔像军团从内部攻破的！这条线索价值连城。这瓶药水是谢礼。",
        "isExit": true,
        "onEnter": [ { "type": "giveItem", "itemId": "mana_potion", "count": 1 }, { "type": "questFlag", "flag": "golem_research" } ]
      },
      "ruin_lore": {
        "text": "城北三十里，古王国的都城。据说宝库钥匙藏在卫兵雕像里。需要考古学识才能安全进入。",
        "isExit": true,
        "onEnter": [ { "type": "questFlag", "flag": "ancient_city_hint" } ]
      },
      "end": { "text": "（芬恩重新埋首卷轴堆中）", "isExit": true }
