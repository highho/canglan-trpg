{
  "blacksmith_hans": {
    "name": "铁匠汉斯",
    "identityTags": ["铁匠"],
    "personalityTags": ["正直"],
    "groups": ["village", "guild"],
    "baseStats": { "HP": 80, "ATK": 10, "DEF": 10, "SPD": 8 },
    "relation": "FRIENDLY",
    "dialogueTree": {
      "start": {
        "root": true,
        "text": "欢迎来到锻造坊！炉火正旺，需要打造点什么吗？",
        "branches": [
          {
            "condition": "HasTag(锻造)",
            "text": "同行？那这把剑送你当见面礼。",
            "next": "gift",
            "actions": [ { "type": "giveItem", "itemId": "iron_sword" }, { "type": "affinity", "amount": 10 } ]
          },
          {
            "condition": "HasTag(矿工)",
            "text": "挖矿的好手！矿洞深处的秘银矿脉，替我留神看看。",
            "next": "mine_talk",
            "actions": [ { "type": "affinity", "amount": 5 } ]
          },
          { "text": "打听一下锻造坊的生意。", "next": "chat" },
          { "text": "随便看看。", "next": "end" }
        ]
      },
      "gift": { "text": "好好用它！剑是用来保护人的，不是用来逞凶的。", "isExit": true },
      "mine_talk": {
        "text": "最近矿道里不太平，听说有骷髅在游荡。你要是下去，千万小心。",
        "branches": [
          { "condition": "HasTag(勇敢)", "text": "有胆色！这份干粮带上。", "next": "end", "actions": [ { "type": "giveItem", "itemId": "travel_rations", "count": 2 } ] },
          { "text": "总之，量力而行。", "next": "end" }
        ]
      },
      "chat": {
        "text": "生意还行。就是铁价涨得厉害，听说北边的商路被强盗截了。",
        "branches": [
          { "text": "强盗的事，我会留意。", "next": "end", "actions": [ { "type": "affinity", "amount": 5 }, { "type": "questFlag", "flag": "heard_bandit_rumor" } ] },
          { "text": "与我无关。", "next": "end" }
        ]
      },
      "end": { "text": "有需要再来。炉火随时为你烧着。", "isExit": true }
    }
  },
  "merchant_lila": {
    "name": "商人莉拉",
    "identityTags": ["商人"],
    "personalityTags": ["贪婪", "狡猾"],
    "groups": ["village", "merchant"],
    "baseStats": { "HP": 60, "ATK": 5, "DEF": 5, "SPD": 9 },
    "relation": "NEUTRAL",
    "dialogueTree": {
      "start": {
        "root": true,
        "text": "稀有的货物，只卖给识货的人。",
        "branches": [
          {
            "text": "来点好货。",
            "next": "trade_node",
            "actions": [ { "type": "affinity", "amount": 5 } ]
          },
          { "condition": "HasTag(贵族)", "text": "贵族的信用，向来可靠。", "next": "noble_talk" },
          { "text": "打听商路的见闻。", "next": "rumor" },
          { "text": "没钱，告辞。", "next": "end" }
        ]
      },
      "trade_node": {
        "text": "成交！这是送你的小赠品。",
        "isExit": true,
        "onEnter": [ { "type": "giveItem", "itemId": "healing_potion", "count": 1 } ]
      },
      "noble_talk": {
        "text": "哟，原来是贵人。王都最近在收购古代钱币，您若有多余的，我高价收。",
        "branches": [
          { "text": "古城里或许能找到。", "next": "end", "actions": [ { "type": "questFlag", "flag": "heard_coin_rumor" }, { "type": "affinity", "amount": 5 } ] },
          { "text": "没兴趣。", "next": "end" }
        ]
      },
      "rumor": {
        "text": "最近森林里的精灵封锁了古道，据说是在防备什么瘟疫……消息可值钱得很。",
        "branches": [
          { "text": "记下了，多谢。", "next": "end", "actions": [ { "type": "questFlag", "flag": "heard_plague_rumor" } ] },
          { "text": "哼，危言耸听。", "next": "end", "actions": [ { "type": "affinity", "amount": -5 } ] }
        ]
      },
      "end": { "text": "下次带上金币再来。", "isExit": true }
    }
  },
  "guild_receptionist": {
    "name": "公会接待员",
    "identityTags": ["冒险者"],
    "personalityTags": ["正义"],
    "groups": ["village", "guild"],
    "baseStats": { "HP": 70, "ATK": 8, "DEF": 8, "SPD": 10 },
    "relation": "FRIENDLY",
    "dialogueTree": {
      "start": {
        "root": true,
        "text": "欢迎来到冒险者公会！",
        "branches": [
          {
            "condition": "NOT HasTag(公会成员)",
            "text": "在这里签下名字，你就是正式冒险者了。",
            "next": "joined",
            "actions": [ { "type": "addTag", "tag": "公会成员" }, { "type": "questFlag", "flag": "first_guild_visit" } ]
          },
          { "condition": "HasTag(公会成员)", "text": "今天的委托已经贴在布告板上了。", "next": "board" },
          { "text": "告辞。", "next": "end" }
        ]
      },
      "joined": {
        "text": "欢迎加入！祝你武运昌隆。",
        "branches": [
          { "text": "有什么适合新人的委托？", "next": "advice" },
          { "text": "谢谢。", "next": "end" }
        ]
      },
      "advice": {
        "text": "村外的巨鼠闹得凶，粮仓都快被啃空了。先从除鼠干起吧。",
        "isExit": true,
        "onEnter": [ { "type": "questFlag", "flag": "rat_quest_hint" } ]
      },
      "board": {
        "text": "布告板上钉满了委托：除鼠、猎狼、护送商队……还有一张落满灰的S级屠龙令。",
        "branches": [
          { "condition": "HasTag(屠龙者)", "text": "您就是那位屠龙勇士！请受我一拜。", "next": "end", "actions": [ { "type": "affinity", "amount": 20 } ] },
          { "text": "我会量力而行。", "next": "end" }
        ]
      },
      "end": { "text": "再见。", "isExit": true }
    }
  },
  "fallen_priest": {
    "name": "堕落祭司",
    "identityTags": ["堕天使"],
    "personalityTags": ["狂热", "冷酷"],
    "groups": ["cult"],
    "baseStats": { "HP": 120, "ATK": 15, "DEF": 10, "SPD": 11, "MATK": 20 },
    "relation": "HOSTILE",
    "dialogueTree": {
      "start": {
        "root": true,
        "text": "黑暗在低语……你听到了吗？",
        "branches": [
          {
            "condition": "HasTag(堕落之印)",
            "text": "原来你是被选中之人……这枚印记归你了。",
            "next": "bless",
            "actions": [ { "type": "affinity", "amount": 20 } ]
          },
          {
            "condition": "HasTag(神圣)",
            "text": "圣光的走狗！休想活着离开！",
            "next": "fight",
            "actions": [ { "type": "enterCombat", "mode": "SPAR" } ]
          },
          {
            "text": "异端！接受制裁吧！",
            "next": "fight",
            "actions": [ { "type": "enterCombat", "mode": "SPAR" } ]
          }
        ]
      },
      "bless": {
        "text": "愿黑暗庇佑你。古城深处的祭坛，有你要找的答案。",
        "isExit": true,
        "onEnter": [ { "type": "questFlag", "flag": "dark_altar_hint" } ]
      },
      "fight": { "text": "那就用实力说话！", "isExit": true }
    }
  },
  "hunter_oda": {
    "name": "猎人奥达",
    "identityTags": ["猎人"],
    "personalityTags": ["谨慎", "忠诚"],
    "groups": ["village", "ranger"],
    "baseStats": { "HP": 75, "ATK": 14, "DEF": 7, "SPD": 13 },
    "relation": "FRIENDLY",
    "dialogueTree": {
      "start": {
        "root": true,
        "text": "（一个背着长弓的男人正擦拭着箭矢）林子最近不太平，进森林前先看看陷阱标记。",
        "branches": [
          {
            "condition": "NOT HasTag(弓术)",
            "text": "想学弓箭？站姿要稳，呼吸要缓。我先教你点皮毛。",
            "next": "learn_bow",
            "actions": [ { "type": "addTag", "tag": "弓术" }, { "type": "affinity", "amount": 10 } ]
          },
          {
            "condition": "HasAllTags([弓术,猎狼人])",
            "text": "狼群清完了？干得漂亮。这片林子又安静了。",
            "next": "end",
            "actions": [ { "type": "giveItem", "itemId": "feather", "count": 3 }, { "type": "affinity", "amount": 10 } ]
          },
          { "text": "森林深处有什么？", "next": "forest_lore" },
          { "text": "先走了。", "next": "end" }
        ]
      },
      "learn_bow": { "text": "记住，箭是用来救命的，不是用来炫耀的。", "isExit": true },
      "forest_lore": {
        "text": "深处有巨蛛的巢穴，再往里……是精灵的封禁之地。没有森林之友的信物，别去送死。",
        "branches": [
          { "condition": "HasTag(森林之友)", "text": "你有信物？那我可以告诉你精灵古道的入口。", "next": "end", "actions": [ { "type": "questFlag", "flag": "elf_path_hint" } ] },
          { "text": "我会小心的。", "next": "end" }
        ]
      },
      "end": { "text": "（奥达重新低下头擦拭箭矢）顺风。", "isExit": true }
    }
  },
  "village_elder_rowan": {
    "name": "村长罗万",
    "identityTags": ["村长"],
    "personalityTags": ["温和", "谨慎"],
    "groups": ["village"],
    "baseStats": { "HP": 50, "ATK": 3, "DEF": 4, "SPD": 4 },
    "relation": "FRIENDLY",
    "dialogueTree": {
      "start": {
        "root": true,
        "text": "（白发苍苍的老村长放下手中的账本）年轻人，村子最近多事之秋，正缺人手。",
        "branches": [
          {
            "condition": "NOT HasTag(公会成员)",
            "text": "先去公会注册吧，有了身份，委托才轮得到你。",
            "next": "end"
          },
          {
            "condition": "HasTag(瘟疫克星)",
            "text": "你救了全村人的命！村口的石碑上会刻下你的名字。",
            "next": "hero",
            "actions": [ { "type": "giveItem", "itemId": "elixir", "count": 1 }, { "type": "affinity", "amount": 30 } ]
          },
          { "text": "村里有什么麻烦？", "next": "troubles" },
          { "text": "告辞。", "next": "end" }
        ]
      },
      "hero": { "text": "愿村子永远记得你的恩情。", "isExit": true },
      "troubles": {
        "text": "一是粮仓闹鼠患；二是北边矿道出了亡灵；三是……南边森林里，好像在闹瘟疫。",
        "branches": [
          { "text": "我先去处理鼠患。", "next": "end", "actions": [ { "type": "questFlag", "flag": "rat_quest_hint" } ] },
          { "text": "矿道的亡灵交给我。", "next": "end", "actions": [ { "type": "questFlag", "flag": "mine_quest_hint" } ] },
          { "text": "瘟疫最要紧。", "next": "end", "actions": [ { "type": "questFlag", "flag": "plague_quest_hint" } ] }
        ]
      },
      "end": { "text": "（老村长点点头，继续翻看账本）", "isExit": true }
    }
  },
  "priestess_liya": {
    "name": "祭司莉雅",
    "identityTags": ["祭司"],
    "personalityTags": ["温和", "忠诚"],
    "groups": ["village", "temple"],
    "baseStats": { "HP": 65, "ATK": 4, "DEF": 6, "SPD": 8, "MATK": 16 },
    "relation": "FRIENDLY",
    "dialogueTree": {
      "start": {
        "root": true,
        "text": "（神殿的烛光摇曳）愿圣光照耀你的旅途。需要治疗，还是祈祷？",
        "branches": [
          {
            "condition": "NOT HasTag(圣光术)",
            "text": "你的眼神里有悲悯。来，我教你最基本的圣光术。",
            "next": "learn_holy",
            "actions": [ { "type": "addTag", "tag": "圣光术" }, { "type": "affinity", "amount": 10 } ]
          },
          {
            "condition": "HasTag(堕落之印)",
            "text": "（莉雅神色凝重）你身上有黑暗的气息……圣殿可以为你驱散，但你要自愿。",
            "next": "purify_offer"
          },
          { "text": "为我治疗伤势。", "next": "heal_node", "actions": [ { "type": "giveItem", "itemId": "healing_potion", "count": 1 } ] },
          { "text": "告辞。", "next": "end" }
        ]
      },
      "learn_holy": { "text": "圣光不问你来自何方，只问你想守护什么。", "isExit": true },
      "purify_offer": {
        "text": "净化仪式需要王者之叶与魔法水晶。你若带来，我便施法。",
        "branches": [
          { "text": "我会去找材料。", "next": "end", "actions": [ { "type": "questFlag", "flag": "purify_quest_hint" } ] },
          { "text": "黑暗是我自己的选择。", "next": "end", "actions": [ { "type": "affinity", "amount": -10 } ] }
        ]
      },
      "heal_node": { "text": "伤痛会愈合的。愿圣光与你同在。", "isExit": true },
      "end": { "text": "（莉雅双手合十，轻声祈祷）", "isExit": true }
    }
  },
  "guard_bruno": {
    "name": "卫兵布鲁诺",
    "identityTags": ["守卫"],
    "personalityTags": ["忠诚", "正直"],
    "groups": ["village", "guard"],
    "baseStats": { "HP": 95, "ATK": 12, "DEF": 14, "SPD": 7 },
    "relation": "FRIENDLY",
    "dialogueTree": {
      "start": {
        "root": true,
        "text": "（巡逻的卫兵抬手示意）站住……哦，是冒险者。夜里别出村，最近强盗活动频繁。",
        "branches": [
          {
            "condition": "NOT HasTag(盾防)",
            "text": "看你身手不错，教你两手盾牌防御的技巧，路上用得上。",
            "next": "learn_shield",
            "actions": [ { "type": "addTag", "tag": "盾防" }, { "type": "affinity", "amount": 5 } ]
          },
          {
            "condition": "HasTag(王国信使)",
            "text": "原来是王国的信使！请恕我失礼，城防情报我可以全部告诉你。",
            "next": "intel",
            "actions": [ { "type": "affinity", "amount": 15 } ]
          },
          { "text": "强盗在哪里出没？", "next": "bandit_info" },
          { "text": "知道了。", "next": "end" }
        ]
      },
      "learn_shield": { "text": "盾不是挡在身前的墙，是护住同伴的门。", "isExit": true },
      "intel": {
        "text": "强盗盘踞在东边山道，有暗哨；矿道亡灵在午夜出没；古城入口的石像鬼会动。",
        "isExit": true,
        "onEnter": [ { "type": "questFlag", "flag": "patrol_intel" } ]
      },
      "bandit_info": {
        "text": "东边山道。他们劫了三批货了，公会悬赏正往上加。",
        "isExit": true,
        "onEnter": [ { "type": "questFlag", "flag": "escort_quest_hint" } ]
      },
      "end": { "text": "（布鲁诺重新握紧长枪，继续巡逻）", "isExit": true }
    }
  },
  "fisherman_gao": {
    "name": "渔夫老高",
    "identityTags": ["渔夫"],
    "personalityTags": ["乐观"],
    "groups": ["village"],
    "baseStats": { "HP": 55, "ATK": 6, "DEF": 5, "SPD": 6 },
    "relation": "FRIENDLY",
    "dialogueTree": {
      "start": {
        "root": true,
        "text": "（老渔夫坐在河边，鱼竿支在一旁）河水清，鱼才肥。小子，要不要学两手？",
        "branches": [
          {
            "condition": "NOT HasTag(钓鱼)",
            "text": "钓鱼讲究耐心。这根旧鱼竿送你，先试试手感。",
            "next": "learn_fish",
            "actions": [ { "type": "addTag", "tag": "钓鱼" }, { "type": "giveItem", "itemId": "raw_fish", "count": 2 }, { "type": "affinity", "amount": 10 } ]
          },
          {
            "condition": "HasTag(渔王)",
            "text": "鱼王！真的是你钓上来的？哈哈哈，后生可畏啊！",
            "next": "end",
            "actions": [ { "type": "affinity", "amount": 20 }, { "type": "giveItem", "itemId": "raw_fish", "count": 3 } ]
          },
          { "text": "最近河里有什么稀罕物？", "next": "river_lore" },
          { "text": "改天吧。", "next": "end" }
        ]
      },
      "learn_fish": { "text": "记住喽，清晨和黄昏，鱼最贪嘴。", "isExit": true },
      "river_lore": {
        "text": "听说河底沉着古王国的沉船，捞上来过古代钱币。钓鱼大赛快到了，想拿鱼王的都盯着深水区呢。",
        "isExit": true,
        "onEnter": [ { "type": "questFlag", "flag": "fishing_contest_hint" } ]
      },
      "end": { "text": "（老高哼着小曲，继续盯着浮标）", "isExit": true }
    }
  },
  "cook_mimi": {
