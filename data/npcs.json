      },
      "creed": {
        "text": "（轻笑）真真假假，看你怎么想。我只偷看得起眼的人——比如贪官，比如恶商。",
        "branches": [
          { "text": "有意思，交个朋友。", "next": "end", "actions": [ { "type": "affinity", "amount": 10 } ] },
          { "text": "贼就是贼。", "next": "end", "actions": [ { "type": "affinity", "amount": -15 } ] }
        ]
      },
      "end": { "text": "（阴影重新合拢，仿佛无人来过）", "isExit": true }
    }
  },
