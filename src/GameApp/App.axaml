<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GameApp.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />

    <!-- ============ 极简文字风全局样式：无图标、无表情、纯文字、黑白灰 ============ -->
    <Style Selector="Window">
      <Setter Property="Background" Value="#FAFAFA" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, Arial" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#1A1A1A" />
    </Style>

    <!-- 按钮：白底细边框纯文字 -->
    <Style Selector="Button">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#1A1A1A" />
      <Setter Property="BorderBrush" Value="#8C8C8C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0F0F0" />
      <Setter Property="BorderBrush" Value="#1A1A1A" />
      <Setter Property="Foreground" Value="#1A1A1A" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#1A1A1A" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#F5F5F5" />
      <Setter Property="Foreground" Value="#B0B0B0" />
      <Setter Property="BorderBrush" Value="#D9D9D9" />
    </Style>

    <!-- 文本框：细边框无圆角 -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#8C8C8C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="6,4" />
    </Style>

    <!-- 下拉框：去圆角 -->
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#8C8C8C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="ComboBox /template/ Border#Border">
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- 标签页：纯文字 -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="#1A1A1A" />
    </Style>

    <!-- 列表：去高亮色块，仅细边框 -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D9D9D9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#ECECEC" />
      <Setter Property="Foreground" Value="#1A1A1A" />
    </Style>

    <!-- 标题文字 -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#737373" />
    </Style>

    <!-- 面板分隔卡片 -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#D9D9D9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14" />
    </Style>
  </Application.Styles>
</Application>
